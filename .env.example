# Laravel API base URL — requests to /api/* and /sanctum/* are proxied here (server-side only).
BACKEND_URL=http://127.0.0.1:8000

# Shown in the UI; the public app URL.
NEXT_PUBLIC_APP_NAME="10X Engage"

# Which environment this build is for: local | staging | production (default production; `next dev` = local).
# Modules not released yet ("Soon" and "Preview" in the sidebar) are hidden in production.
NEXT_PUBLIC_APP_ENV=

# Dev only: comma-separated extra hostnames allowed to open the dev server, e.g. your ngrok domain
# (Meta Embedded Signup only runs on HTTPS domains listed in the app's allowed domains).
ALLOWED_DEV_ORIGINS=

# Realtime inbox (Laravel Reverb). Leave KEY empty to fall back to polling.
# KEY = the backend's REVERB_APP_KEY. The browser connects to Reverb directly.
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
